# Lead Finder activation settings. `npm run setup` copies this to .env, adds
# the activation secret and builds them into the app. Never commit .env.

# The only address activation codes (OTPs) are sent to: the administrator.
ADMIN_EMAIL=info.axoraweb@gmail.com

# Outgoing mail, used by the app itself. These settings are built into every
# installed copy, where they can be extracted, so use a SEND-ONLY SMTP key
# from a transactional email service (Brevo, Mailgun, SendGrid, Amazon SES,
# ...). Never use the password or App Password of a real mailbox (for Gmail
# that would let someone read the Sent folder, and the codes in it).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lead Finder Activation <you@example.com>"

# Shown in the app's Activate panel (WhatsApp and Call buttons). Written into
# the app by `npm run setup`. Digits with country code for WhatsApp.
CONTACT_WHATSAPP=923245237429
CONTACT_PHONE=+923245237429

# Created by `npm run setup`. Seals the activation records in the app. Keep
# it backed up: a new one ends existing activations in later builds.
ACTIVATION_SECRET=
