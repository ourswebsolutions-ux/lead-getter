# Lead Finder activation tool. `npm run setup` copies this to .env and adds
# the activation secret. Never commit .env and never share it.

# The only address activation codes are sent to (the administrator).
ADMIN_EMAIL=info.axoraweb@gmail.com

# Outgoing mail (e.g. Gmail: smtp.gmail.com, port 465, an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lead Finder Activation <you@example.com>"

# Shown in the app's Activate panel (WhatsApp and Call buttons). Written into
# the app by `npm run setup`. Digits with country code for WhatsApp.
CONTACT_WHATSAPP=923245237429
CONTACT_PHONE=+923245237429

# Tests only: write emails as files in this folder instead of sending them.
# MAIL_OUTBOX_DIR=./outbox

# Created by `npm run setup`. The app is built with the same value (git-ignored
# src/main/activation-secret.json locally; the ACTIVATION_SECRET GitHub secret
# for releases). Keep it secret and backed up.
ACTIVATION_SECRET=
