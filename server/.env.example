# Lead Finder licence server. Copy to .env (npm run setup does this) and fill in.
# Never commit .env.

PORT=8787
HOST=127.0.0.1
# Public HTTPS address of this server; used in the Approve/Cancel email links.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Hosts that block SMTP (Render free tier): set BREVO_API_KEY instead of the
# SMTP_HOST/PORT/USER/PASS lines; SMTP_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lead Finder <you@example.com>"
SUBSCRIPTION_ADMIN_EMAIL=info.axoraweb@gmail.com

# Shown to users on the plans screen (how to pay).
PAYMENT_INSTRUCTIONS=

# Created by `npm run setup`. Keep secret.
LICENSE_PRIVATE_KEY=

# Supabase (subscriptions only). Secret key and DB password stay on this server.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Session pooler (IPv4). URL-encode the password (@ becomes %40).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_CA=certs/supabase-root-2021-ca.crt
SUPABASE_SCHEMA=leadfinder
SUPABASE_BUCKET=payment-screenshots
# Set to 0 to skip scheduling the hourly pg_cron cleanup.
SUPABASE_CRON=1

# Storage management
SCREENSHOT_RETENTION_DAYS=90
USAGE_DB_LIMIT_MB=500
USAGE_STORAGE_LIMIT_MB=1024
USAGE_ALERT_PERCENTS=80,90,95
MAINTENANCE_INTERVAL_HOURS=6
MAINTENANCE_MAX_DELETES=200
MAINTENANCE_DRY_RUN=0
