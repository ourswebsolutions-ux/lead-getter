# Lead Finder licence server. Copy to .env (npm run setup does this) and fill in.
# Never commit .env.

PORT=8787
HOST=127.0.0.1
# Address of this server, used in the Approve/Cancel email links. Production:
# https://subscription.axorawebsolutions.com/lead-getter (a path prefix works).
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Subscription database and payment screenshots (relative to server/).
DATA_DIR=./data

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lead Finder <you@example.com>"
SUBSCRIPTION_ADMIN_EMAIL=info.axoraweb@gmail.com

# Shown to users on the plans screen (how to pay).
PAYMENT_INSTRUCTIONS=

# Axora subscription website. When the token is set, it decides who has a
# paid subscription (status is read from it on every check). The token is the
# website's ADMIN_API_TOKEN: keep it here only, never in the desktop app.
SUBSCRIPTION_API_URL=https://subscription.axorawebsolutions.com/api/v1
SUBSCRIPTION_API_TOKEN=

# Created by `npm run setup`. Keep secret.
LICENSE_PRIVATE_KEY=
