# Lead Finder licence server. Copy to .env (npm run setup does this) and fill in.
# Never commit .env.

PORT=8787
HOST=127.0.0.1
# Address of this server. Production is the subscription website:
# https://subscription.axorawebsolutions.com/lead-getter (a path prefix works).
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Subscription database (relative to server/).
DATA_DIR=./data

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lead Finder <you@example.com>"
# Receives every Activation ID and its 4-digit code (the only recipient).
SUBSCRIPTION_ADMIN_EMAIL=info.axoraweb@gmail.com

# Shown to users on the plans screen (how to pay).
PAYMENT_INSTRUCTIONS=

# Daily lead allowances reset at midnight in this timezone.
CREDITS_TIMEZONE=Asia/Karachi
# Optional: prices (PKR), durations (months) and daily allowances.
# PLAN_MONTHLY_PRICE=3000
# PLAN_MONTHLY_MONTHS=1
# PLAN_MONTHLY_DAILY_LEADS=100
# PLAN_SIX_MONTHS_PRICE=10000
# PLAN_SIX_MONTHS_MONTHS=6
# PLAN_SIX_MONTHS_DAILY_LEADS=250
# PLAN_ONE_TIME_PRICE=20000
# PLAN_FREE_DAILY_MAPS=5
# PLAN_FREE_DAILY_FACEBOOK=5

# Created by `npm run setup`. Keep secret.
LICENSE_PRIVATE_KEY=
