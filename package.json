{
  "name": "lead-finder",
  "version": "1.9.0",
  "description": "Finds Google Maps businesses with or without websites using your own Chrome.",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "vite build && node scripts/dev.js --prod",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration/real-chrome.js",
    "test:e2e": "vite build && node --test --test-timeout=200000 test/e2e/app.e2e.js test/e2e/activation.e2e.js test/e2e/access.e2e.js test/e2e/sources.e2e.js test/e2e/design.e2e.js test/e2e/premium.e2e.js test/e2e/whatsapp.e2e.js test/e2e/outreach.e2e.js test/e2e/many-leads.e2e.js test/e2e/facebook.e2e.js test/e2e/live-leads.e2e.js test/e2e/podcasts.e2e.js test/e2e/people.e2e.js test/e2e/dialer.e2e.js",
    "release": "node scripts/release.js"
  },
  "author": {
    "name": "Axora Web",
    "email": "info.axoraweb@gmail.com"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "baileys": "^7.0.0-rc14",
    "electron-updater": "^6.8.9",
    "libphonenumber-js": "^1.13.15",
    "nodemailer": "^7.0.13",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "Lead Finder",
  "private": true,
  "build": {
    "appId": "com.leadfinder.app",
    "productName": "Lead Finder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "src/preload/**",
      "src/browser/**",
      "src/database/**",
      "src/export/**",
      "src/whatsapp/**",
      "src/dialer/**",
      "dist/renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "src/dialer/bt-helper.py"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Axora Web <info.axoraweb@gmail.com>",
      "synopsis": "Find Google Maps business leads with your own Chrome",
      "executableName": "lead-finder",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Lead-Finder-Setup-${version}.${ext}"
    },
    "copyright": "Copyright © 2026 Axora Web",
    "icon": "build/icon.png",
    "artifactName": "Lead-Finder-${version}-${os}-${arch}.${ext}",
    "deb": {
      "artifactName": "lead-finder_${version}_${arch}.${ext}",
      "recommends": [
        "python3-dbus",
        "python3-gi",
        "pulseaudio-utils"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ourswebsolutions-ux",
        "repo": "lead-getter",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/ourswebsolutions-ux/lead-getter",
  "repository": {
    "type": "git",
    "url": "https://github.com/ourswebsolutions-ux/lead-getter.git"
  },
  "desktopName": "lead-finder.desktop"
}
